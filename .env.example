# ==============================================================================
# ROJLO ENVIRONMENT VARIABLES TEMPLATE
# Do NOT place real secrets, passwords, or tokens in this file.
# Copy this to .env (or configure in Hostinger Node.js Web App environment settings).
# ==============================================================================

# Node Environment & Port
NODE_ENV=production
PORT=3000

# Database (MariaDB / MySQL on Hostinger)
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# Database (MongoDB - Kept for fallback/data migration)
MONGODB_URI=
MONGODB_DB=rojlo

# Authentication & Security (Required - minimum 32 random characters)
JWT_SECRET=
JWT_TOKEN_EXPIRY=30d
OTP_HASH_SECRET=

# Admin Master Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOKEN=

# VIP Portal URLs
NEXT_PUBLIC_VIP_URL=https://rojlo.in/vip/login
VIP_LOGIN_URL=https://rojlo.in/vip/login

# Cloudinary (Media / Image Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP (OTP & Notification delivery)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rojlo <noreply@rojlo.in>"

# Public Website Configuration
NEXT_PUBLIC_SITE_NAME=Rojlo
NEXT_PUBLIC_SITE_URL=https://rojlo.in

# Default Payment / UPI Configuration (Fallback)
DEFAULT_UPI_ID=
DEFAULT_UPI_NAME=
DEFAULT_UPI_QR=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
